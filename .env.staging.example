# Staging config. Copy to .env.staging (gitignored) for the staging:* scripts and
# `npm run dev:staging`, and mirror the same values into Railway's staging environment.
# See docs/STAGING.md.

APP_ENV=staging

# Jobtread — same org and grant key as production; access is limited to these jobs.
JOBTREAD_GRANT_KEY=
JOBTREAD_ORG_ID=
JOBTREAD_ALLOWED_JOB_IDS=22PcxVVzRLCk
# true = reads see every real job (writes stay limited to the allowlist)
JOBTREAD_STAGING_READ_ALL=false

# Supabase — the STAGING project, never production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Slack — the "Thomas Pools Agent (Staging)" app, never the production app
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEST_CHANNEL_ID=
# Every channel setting points at the test channel too
SLACK_MORNING_CHANNEL=
SLACK_EVENING_CHANNEL=
SLACK_PAYMENT_CHANNEL=
SLACK_ERROR_CHANNEL=

# Google Calendar — a separate test calendar shared with the service account
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

ANTHROPIC_API_KEY=

# Leave unset so the test job's PM isn't filtered out of check-ins
PILOT_PM=

# Crons stay off in staging unless set to true
# CRONS_ENABLED=false
CRON_SECRET=

# Used by npm run staging:trigger
STAGING_URL=https://<your-staging-service>.up.railway.app

# Twilio (vendor outreach is deferred; staging refuses to send without a test phone)
VENDOR_OUTREACH_TEST_PHONE=
